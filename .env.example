# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use (optional, default: claude-sonnet-4-5)
CLAUDE_MODEL=claude-sonnet-4-5

# Maximum tokens per response (optional, default: 1024)
MAX_TOKENS=1024

# Server settings (optional)
HOST=0.0.0.0
PORT=8000

# MongoDB (optional; defaults shown)
# With auth enabled: mongodb://user:pass@localhost:27017/claude_sap_ai?authSource=claude_sap_ai
MONGODB_URI=mongodb://localhost:27017/claude_sap_ai
MONGODB_DATABASE=claude_sap_ai

# SAP Help Portal search endpoint used by the seeder (optional)
SAP_HELP_SEARCH_URL=https://help.sap.com/http.svc/elasticsearch
